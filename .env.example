# Gmail SMTP for tour booking & taxi inquiries.
# Set these in Vercel -> Project -> Settings -> Environment Variables (and in .env.local for local dev).
# If not set, inquiries are still accepted and confirmed on screen, but no emails are sent.
GMAIL_USER="your-email@gmail.com"
GMAIL_APP_PASSWORD="your-16-character-app-password"
NOTIFICATION_EMAIL="bookings@rangrezholidays.com"
